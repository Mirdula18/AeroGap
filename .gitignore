# Secrets — never commit
.env
.env.*
!.env.example
api.txt
*.key

# Office / document files — pitch decks and templates live outside the repo
*.pptx
*.pdf
*.docx

# Data (large, regenerable, may contain cached API responses).
# Leading slash: only the top-level folder, so web/public/data (the static map
# snapshot the free host serves) stays in the repo.
/data/
*.parquet
*.duckdb
*.duckdb.wal

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Node / web
node_modules/
web/dist/
web/build/
.vercel/
.netlify/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
