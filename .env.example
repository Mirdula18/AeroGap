# Copy to .env and fill in. Never commit .env.

# data.gov.in API key (CPCB real-time AQI) — https://data.gov.in
DATA_GOV_IN_API_KEY=

# NASA FIRMS MAP_KEY — https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Google Earth Engine Cloud project id (noncommercial, no billing) — https://code.earthengine.google.com/register
# Also run `earthengine authenticate` once.
EE_PROJECT=

# Gemini via Google AI Studio (single key, free tier) — https://aistudio.google.com
GEMINI_API_KEY=
